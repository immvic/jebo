    private onSubscribeGlobal(req: JiboServerRequest, res: JiboServerResponse) \{\
        log.info(`onSubscribeGlobal: `, req.body);\
        const requestID = String(this.requestIDCounter++);\
        const body: types.SubscribeGlobalOptions = req.body;\
        const sub: GlobalRuleSubscription = \{\
            rules: body.nluRules,\
            requestID\
        \};\
        if (body.exclusive) \{\
            this.activeExclusiveGlobalRules.push(sub);\
        \} else \{\
            this.activeGlobalRules.push(sub);\
        \}\
\
        res.statusCode = 200;\
        res.statusMessage = 'OK';\
        res.end(JSON.stringify(\{ requestID \}));\
    \}\
