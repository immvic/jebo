    private onCancelLocalTurn(req: JiboServerRequest, res: JiboServerResponse) \{\
        log.info(`onCancelLocalTurn: `, req.body);\
        //cancel local turn API is used to cancel local, enrollment, and pronunciation turns\
        if (this.activeTurn && this.state !== State.GLOBAL_TURN) \{\
            const activeRequestID = this.activeTurn.requestID;\
            if (!req.body.requestID) \{\
                log.warn(`Missing requestID`);\
            \}\
            else if (req.body.requestID !== activeRequestID) \{\
                log.warn(`Supplied requestID '$\{req.body.requestID\}' not equal to active requestID '$\{activeRequestID\}'`);\
            \}\
            else \{\
                this.activeTurn.close();\
                this.activeTurn = null;\
                this.state = State.IDLE;\
            \}\
        \} else if (!this.activeTurn) \{\
            log.warn(`No active local session to cancel`);\
        \} else \{\
            log.warn(`Can't cancel local turn in state '$\{this.state\}'`);\
        \}\
        res.statusCode = 200;\
        res.statusMessage = 'OK';\
        res.end(JSON.stringify(\{\}));\
    \}\
