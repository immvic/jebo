    private ruleListContainsARule(list: string[], comparison: string[]): boolean \{\
        if (!list || !list.length || !comparison || !comparison.length) \{\
            return false;\
        \}\
        //comparison will be the NLU match list, so will probably be just one item, but just in case\
        for (let i = 0; i < comparison.length; ++i) \{\
            if (list.includes(comparison[i])) \{\
                return true;\
            \}\
        \}\
        return false;\
    \}\
