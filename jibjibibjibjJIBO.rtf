    private onUpdateLocalTurn(req: JiboServerRequest, res: JiboServerResponse) \{\
        log.info(`onUpdateLocalTurn: `, req.body);\
        if (this.activeTurn && this.state === State.LOCAL_TURN) \{\
            const activeRequestID = this.activeTurn.requestID;\
            if (!req.body.requestID) \{\
                log.warn(`Missing requestID`);\
            \}\
            else if (req.body.requestID !== activeRequestID) \{\
                log.warn(`Supplied requestID '$\{req.body.requestID\}' not equal to active requestID '$\{activeRequestID\}'`);\
            \}\
            else if (!req.body.clientNLU && !req.body.clientASR) \{\
                log.warn(`Request did not contain clientNLU or clientASR`, req.body);\
            \}\
            else \{\
                const body: types.LocalTurnUpdate = req.body;\
                const speech: SpeechOptions = \{\};\
                if (body.clientNLU) \{\
                    speech.nlu = body.clientNLU;\
                \} else \{\
                    speech.speech = \{\
                        words: body.clientASR,\
                        final: true,\
                        speaker: null,\
                        speakerId: null,\
                    \};\
                \}\
                this.updateSpeechTurn(speech);\
            \}\
        \} if (!this.activeTurn) \{\
            log.warn(`No active local session to update`);\
        \} else \{\
            log.warn(`Can't update local turn in state '$\{this.state\}'`);\
        \}\
        res.statusCode = 200;\
        res.statusMessage = 'OK';\
        res.end(JSON.stringify(\{\}));\
    \}\
