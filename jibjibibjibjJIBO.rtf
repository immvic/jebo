    /**\
     * This cancels the selected turn session\
     * @param \{SimulatedSpeech\} speech\
     */\
    public async cancelSpeechTurn(): Promise<void> \{\
        if (this.activeTurn) \{\
            this.activeTurn.close();\
            this.activeTurn = null;\
            this.state = State.IDLE;\
        \}\
    \}\
\
    private getActiveGlobals(launchToAppend: string | string[] = []): string[] \{\
        const reducer = (arr, item) => \{\
            //reduce rules into one flat list\
            arr.push(...item.rules);\
            return arr;\
        \};\
        //determine the list of rules we should use\
        if (this.activeExclusiveGlobalRules.length) \{\
            //return exclusive globals\
            return this.activeExclusiveGlobalRules.reduce(reducer, []);\
        \}\
        //return general globals AND the launch rule(s) to append\
        return this.activeGlobalRules.reduce(reducer, []).concat(launchToAppend);\
    \}\
\
    /**\
     * This updates the selected turn session\
     * @param \{SimulatedSpeech\} speech\
     * @param \{boolean\} global Whether to use global turn or local\
     */\
    private async startSpeechTurn(options: SpeechOptions = \{\}): Promise<void> \{\
        log.info(`startSpeechTurn `, options);\
        let turn = this.activeTurn;\
        const targetState = options.global ? State.GLOBAL_TURN : State.LOCAL_TURN;\
        this.state = targetState;\
\
        if (turn) \{\
            log.warn(`Hub session was already open when starting '$\{targetState\}', stopping`);\
            turn.close();\
            turn = null;\
        \}\
\
        log.info(`Starting '$\{this.state\}'`);\
        const requestID = options.global ? types.GLOBAL_REQUEST : options.requestID;\
\
        let suppressed: types.ServiceEventType[] = [];\
        if (options.mimicGlobalOptions) \{\
            suppressed = options.mimicGlobalOptions.suppressedEvents;\
        \} else if (options.turnOptions) \{\
            suppressed = options.turnOptions.suppressedEvents;\
        \}\
\
        if (options.global) \{\
            this.writeToJetStreamClient(\{\
                type: types.ServiceEventType.HJ_HEARD,\
                requestID: requestID,\
                transID: '',\
                ts: Date.now(),\
                data: undefined\
            \}, suppressed);\
            this.events.hjHeard.emit();\
            if (this.hjMode === HJMode.ONLY_HJ && !options.mimicGlobalOptions) \{\
                this.state = State.IDLE;\
                return;\
            \}\
        \}\
\
        // Create a new session\
        const listenOptions: types.ListenMessageData = \{\
            hotphrase: !!options.global,\
            rules: options.global ? this.getActiveGlobals('launch') : this.getActiveGlobals(),\
            mode: types.ListenMessageMode.CLIENT_ASR,\
            lang: 'en-US'\
        \};\
        let earlyEOS: string[];\
        if (options.turnOptions) \{\
            if (options.turnOptions.ignoreGlobalRules) \{\
                listenOptions.rules = [];\
            \}\
            if (options.turnOptions.nluRules) \{\
                listenOptions.rules = listenOptions.rules.concat(options.turnOptions.nluRules);\
            \}\
            if (options.turnOptions.earlyEOS && options.turnOptions.earlyEOS.length) \{\
                earlyEOS = options.turnOptions.earlyEOS;\
                //replace the yes/no token\
                if (earlyEOS.includes('$YESNO')) \{\
                    earlyEOS.splice(earlyEOS.indexOf('$YESNO'), 1, ...YES_NO_EOS);\
                \}\
            \}\
            if (options.turnOptions.clientNLU) \{\
                options.nlu = options.turnOptions.clientNLU;\
                listenOptions.mode = types.ListenMessageMode.CLIENT_NLU;\
            \} else if (options.turnOptions.clientASR) \{\
                options.speech = \{\
                    words: options.turnOptions.clientASR,\
                    final: true,\
                    speaker: null,\
                    speakerId: null,\
                \};\
            \}\
        \} else if (options.mimicGlobalOptions) \{\
            if (options.mimicGlobalOptions.clientNLU) \{\
                options.nlu = options.mimicGlobalOptions.clientNLU;\
                listenOptions.mode = types.ListenMessageMode.CLIENT_NLU;\
            \} else if (options.mimicGlobalOptions.clientASR) \{\
                options.speech = \{\
                    words: options.mimicGlobalOptions.clientASR,\
                    final: true,\
                    speaker: null,\
                    speakerId: null,\
                \};\
            \}\
        \}\
        log.info(`Starting Hub session with options: `, listenOptions);\
\
\
        const hubOptions = this.createHubOptions('/listen');\
        const session = await HubClient.startListenSession(hubOptions, listenOptions);\
        this.subscribeToCommonEvents(session, requestID, suppressed);\
        //set up sos & eos timeout options, using defaults and if local, the local options as well\
        const timeoutOpts = Object.assign(\{earlyEOS\}, options.global ? GLOBAL_TURN_TIMEOUTS : DEFAULT_LOCAL_TURN_TIMEOUTS, options.global ? \{\} : options.turnOptions);\
        turn = this.activeTurn = new HubListenTurn(options.global ? State.GLOBAL_TURN : State.LOCAL_TURN, requestID, session, timeoutOpts, this);\
\
        session.events.on('SOS', () => \{\
            log.info(`Received from hub 'SOS'`);\
            this.writeToJetStreamClient(\{\
                type: types.ServiceEventType.SOS,\
                requestID: requestID,\
                transID: session.transactionID,\
                ts: Date.now(),\
                data: undefined\
            \}, suppressed);\
        \});\
        session.events.on('EOS', () => \{\
            log.info(`Received from hub 'EOS'`);\
            this.writeToJetStreamClient(\{\
                type: types.ServiceEventType.EOS,\
                requestID: requestID,\
                transID: session.transactionID,\
                ts: Date.now(),\
                data: undefined\
            \}, suppressed);\
        \});\
        session.events.on('LISTEN', (data) => \{\
            log.info(`Received from hub 'LISTEN': `, data);\
            let globalOverride = false;\
            //if this is a local turn, then we need to make sure we didn't get a global result\
            if (this.activeTurn && this.activeTurn.type === State.LOCAL_TURN && data.nlu && data.nlu.rules && data.nlu.rules.length) \{\
                if (!this.ruleListContainsARule(options.turnOptions.nluRules, data.nlu.rules)) \{\
                    log.info('Local turn did not match a global rule, overriding as a global listen');\
                    globalOverride = true;\
                \}\
            \}\
            if (globalOverride) \{\
                //interrupt local turn\
                this.writeToJetStreamClient(\{\
                    type: types.ServiceEventType.TURN_RESULT,\
                    requestID: requestID,\
                    transID: session.transactionID,\
                    ts: Date.now(),\
                    data: \{\
                        global: false,\
                        status: types.TurnResultType.INTERRUPTED\
                    \}\
                \}, suppressed);\
                //now write a global turn request response\
                this.writeToJetStreamClient(\{\
                    type: types.ServiceEventType.TURN_RESULT,\
                    requestID: types.GLOBAL_REQUEST,\
                    transID: session.transactionID,\
                    ts: Date.now(),\
                    data: \{\
                        global: true,\
                        status: types.TurnResultType.SUCCEEDED,\
                        result: \{\
                            asr: data.asr,\
                            nlu: data.nlu,\
                            match: data.match\
                        \}\
                    \}\
                \});\
            \} else \{\
                //normal local or global turn ending\
                this.writeToJetStreamClient(\{\
                    type: types.ServiceEventType.TURN_RESULT,\
                    requestID: requestID,\
                    transID: session.transactionID,\
                    ts: Date.now(),\
                    data: \{\
                        global: !!options.global,\
                        status: types.TurnResultType.SUCCEEDED,\
                        result: \{\
                            asr: data.asr,\
                            nlu: data.nlu,\
                            match: data.match\
                        \}\
                    \}\
                \}, suppressed);\
            \}\
        \});\
\
        this.writeToJetStreamClient(\{\
            type: types.ServiceEventType.TURN_STARTED,\
            transID: session.transactionID,\
            requestID: requestID,\
            ts: Date.now(),\
            data: undefined,\
        \}, suppressed);\
\
        const speakers: types.HubSpeakerRecogResults = (options.speech && options.speech.speakerId) ? \{\
            accepted: [\{\
                id: options.speech.speakerId,\
                high_confidence: true,\
                score: 1\
            \}]\
        \} : undefined;\
\
        if (speakers) \{\
            // Write speakerID event to Jetstream Client for identity servie\
            this.writeToJetStreamClient(\{\
                type: types.ServiceEventType.SPEAKER_ID,\
                transID: session.transactionID,\
                requestID: requestID,\
                ts: Date.now(),\
                data: \{\
                    snr: 1,\
                    speakers: speakers.accepted.map(accepted => \{\
                        return \{\
                            speaker: accepted.id,\
                            score: accepted.score,\
                            accepted: true,\
                            high_confidence: accepted.high_confidence\
                        \};\
                    \})\
                \}\
            \});\
        \}\
\
        // Send context message to Hub\
        const context = Object.assign(\{\}, CONTEXT_MSG, await this.getContext(speakers));\
        //if the turn was cancelled or otherwise is no longer active, bail\
        if (turn !== this.activeTurn) \{\
            return;\
        \}\
        log.debug('Sending context message to hub', context);\
        session.writeContext(context);\
\
        //send any clientASR or clientNLU data to the turn now, and return to idle if it is complete\
        await this.updateSpeechTurn(options);\
    \}\
\
    /**\
     * This updates the selected turn session\
     * @param \{SimulatedSpeech\} speech\
     * @param \{boolean\} global Whether to use global turn or local\
     */\
    private async updateSpeechTurn(options: SpeechOptions = \{\}): Promise<void> \{\
        log.info(`updateSpeechTurn `, options);\
        let turn = this.activeTurn;\
        if (turn) \{\
            try \{\
                const complete = await turn.update(options, this);\
                if (complete) \{\
                    // Clear all session data\
                    this.activeTurn = null;\
                    this.state = State.IDLE;\
                \}\
            \} catch (error) \{\
                log.error(error);\
                this.writeToJetStreamClient(\{\
                    type: types.ServiceEventType.ERROR,\
                    transID: turn.transactionID,\
                    requestID: turn.requestID,\
                    ts: Date.now(),\
                    data: \{\
                        message: error.message\
                    \}\
                \});\
\
                // Clear all session data\
                this.activeTurn = null;\
                this.state = State.IDLE;\
            \}\
        \} else \{\
            log.error(`No active session`);\
        \}\
    \}\
\
    private async connectToContextService(): Promise<void> \{\
        if (this.timedOutWatingForContext) \{\
            return Promise.reject(`Timed out earlier when searching for Context Service`);\
        \}\
\
        const oldState = this.state;\
        this.state = State.CONNECTING_TO_CONTEXT;\
        log.info(`Starting to look for the context service`);\
        return new Promise<void>((resolve, reject) => \{\
            // Here is where we wait for the context service to announce itself\
            let startTime = Date.now();\
            let contextSrvCheckInterval = setInterval(() => \{\
                const record = RegistryService.instance.registry.records.find(r => (r.name === 'context'));\
                if (record) \{\
                    log.info(`Found Context service at port $\{record.port\} after $\{Date.now() - startTime\} ms`);\
                    clearInterval(contextSrvCheckInterval);\
                    this.state = oldState;\
                    this.contextClient = new HTTPClient('127.0.0.1', record.port);\
                    resolve();\
                \} else if (Date.now() - startTime > 20000) \{\
                    clearInterval(contextSrvCheckInterval);\
                    this.state = State.ERROR;\
                    this.timedOutWatingForContext = true;\
                    reject(new Error(`Timeout in Jetstream sim waiting for context service`));\
                \}\
            \}, 100);\
        \});\
    \}\
\
    /**\
     * Retrieves context data from the Context service (hosted in Be)\
     */\
    private async getContext(speakers?: types.HubSpeakerRecogResults, omitLoop = false): Promise<any> \{\
        return new Promise((resolve, reject) => \{\
            if (!this.contextClient) \{\
                reject(new Error(`Context client not ready`));\
            \} else \{\
                this.contextClient.sendRequest('POST', '/context', JSON.stringify(\{ speakers, omitLoop \}), (error, response) => \{\
                    // If the context service isn't there, then we attempt reconnecting\
                    if (error) \{\
                        if (error.message.indexOf('ECONNREFUSED') >= 0) \{\
                            log.warn(`Context service down, trying to reconnect`);\
                            this.connectToContextService()\
                                .then(() => this.getContext(speakers, omitLoop))\
                                .then(resolve)\
                                .catch(reject);\
                        \} else \{\
                            reject(new Error(`Error retrieving context: $\{error.message\}`));\
                        \}\
                    \} else \{\
                        resolve(response);\
                    \}\
                \});\
            \}\
        \});\
    \}\
\
    private createRequestID(): string \{\
        return `rid:$\{this.requestIDCounter++\}`;\
    \}\
\
    private prepareResponse(res: JiboServerResponse) \{\
        res.setHeader('Content-Type', 'application/json');\
    \}\
