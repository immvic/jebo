    private async onProactiveTrigger(req: JiboServerRequest, res: JiboServerResponse) \{\
        log.info(`Got proactive trigger request`);\
\
        // Send back Jetstream response of request received\
        const requestID = this.createRequestID();\
        res.end(JSON.stringify(\{\
            requestID,\
        \}));\
\
        // Hub options for proactive\
        const hubOptions = this.createHubOptions('/proactive');\
        try \{\
            // Send proactive request to Hub\
            this.activeProactiveSession = await HubClient.startProactiveSession(hubOptions, req.body);\
            this.subscribeToCommonEvents(this.activeProactiveSession, requestID);\
            // On response\
            this.activeProactiveSession.events.on('PROACTIVE', (data) => \{\
                log.info(`Received from hub 'PROACTIVE': `, data);\
                this.writeToJetStreamClient(\{\
                    type: types.ServiceEventType.PROACTIVE,\
                    requestID: requestID,\
                    transID: this.activeProactiveSession.transactionID,\
                    ts: Date.now(),\
                    data: data as any\
                \});\
            \});\
\
            // Send context message to Hub\
            const context = Object.assign(\{\}, CONTEXT_MSG, await this.getContext());\
            log.debug('Sending context message to hub', context);\
            this.activeProactiveSession.writeContext(context);\
        \}\
        catch (error) \{\
            const transID = this.activeProactiveSession ? this.activeProactiveSession.transactionID : null;\
            this.emitError(error, transID, requestID);\
        \}\
    \}\
\
    private subscribeToCommonEvents(\
        session: hub_session.ClientSession,\
        requestID: string,\
        suppressed?: types.ServiceEventType[]\
    ) \{\
        session.events.on('SKILL_ACTION', (data) => \{\
            log.info(`Received from hub 'SKILL_ACTION': `, data);\
            this.writeToJetStreamClient(\{\
                type: types.ServiceEventType.SKILL_ACTION,\
                requestID: requestID,\
                transID: session.transactionID,\
                ts: Date.now(),\
                data\
            \}, suppressed);\
        \});\
        session.events.on('SKILL_REDIRECT', (data) => \{\
            log.info(`Received from hub 'SKILL_REDIRECT': `, data);\
            this.writeToJetStreamClient(\{\
                type: types.ServiceEventType.SKILL_REDIRECT,\
                requestID: requestID,\
                transID: session.transactionID,\
                ts: Date.now(),\
                data\
            \}, suppressed);\
        \});\
        session.events.on('ERROR', error => log.error(error));\
    \}\
